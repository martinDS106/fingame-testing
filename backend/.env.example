# Copy to `backend/.env` (gitignored). Used only by Nest + Prisma on this machine/server.

PORT=3001

# MySQL connection string (example matches docker-compose in this repo)
DATABASE_URL="mysql://fin_game:fin_game_pw@localhost:3307/fin_game"

# JWT signing (keep secrets on the server only; never put these in the Expo app .env)
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret_different_from_access

# Admin emails (comma-separated). Users with these emails become admins on login/signup.
# Example: ADMIN_EMAILS=you@example.com,other@example.com
ADMIN_EMAILS=

# SMTP (for password reset OTP emails)
# Cheapest/best long-term: AWS SES SMTP credentials (requires domain verification).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Fin-Game <no-reply@yourdomain.com>"
