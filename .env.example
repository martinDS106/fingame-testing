# -----------------------------------------------------------------------------
# Expo app (repo ROOT) — copy to `.env` in this folder (gitignored).
# Do NOT put JWT secrets or DATABASE_URL here; those belong in `backend/.env`.
# -----------------------------------------------------------------------------

EXPO_PUBLIC_ENABLE_ADMIN_UI=false
EXPO_PUBLIC_ADMIN_EMAILS=admin1@example.com,admin2@example.com

# Nest API base URL (reachable from the phone/emulator). No trailing slash.
# LAN example: http://192.168.1.10:3001
# Same machine emulator (Android): http://10.0.2.2:3001
# Production web admin (Vercel/Netlify build): https://fingame-testing-production-557d.up.railway.app
EXPO_PUBLIC_API_BASE_URL=

# --- Hosted admin (set on Vercel/Netlify at BUILD time; see docs/ADMIN_WEB_DEPLOY.md) ---
# EXPO_PUBLIC_ENABLE_ADMIN_UI=true
# EXPO_PUBLIC_ADMIN_EMAILS=admin@example.com,dev@example.com
